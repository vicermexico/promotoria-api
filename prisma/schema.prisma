generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model addresses {
  id                 Int       @id @default(autoincrement()) @db.UnsignedInt
  entity_type        String    @db.VarChar(50)
  entity_id          Int       @db.UnsignedInt
  id_country         Int       @db.UnsignedInt
  id_state           Int       @db.UnsignedInt
  id_city            Int       @db.UnsignedInt
  street             String    @db.VarChar(150)
  ext_number         String    @db.VarChar(20)
  int_number         String?   @db.VarChar(20)
  neighborhood       String?   @db.VarChar(100)
  postal_code        String    @db.VarChar(20)
  address_references String?   @db.Text
  latitude           Decimal?  @db.Decimal(10, 8)
  longitude          Decimal?  @db.Decimal(11, 8)
  is_active          Boolean   @default(true)
  created_at         DateTime  @default(now()) @db.Timestamp(0)
  updated_at         DateTime  @default(now()) @db.Timestamp(0)
  city               cities    @relation(fields: [id_city], references: [id])
  country            countries @relation(fields: [id_country], references: [id])
  state              states    @relation(fields: [id_state], references: [id])

  @@index([id_city], map: "addresses_id_city_fkey")
  @@index([id_country], map: "addresses_id_country_fkey")
  @@index([id_state], map: "addresses_id_state_fkey")
}

/// Registro no-destructivo de cada archivo subido al bucket (imágenes/docs).
/// Una entidad puede tener varias versiones; la vigente es is_active = true.
/// Nunca se borra: las versiones viejas quedan como is_active = false.
model assets {
  id_asset    Int      @id @default(autoincrement()) @db.UnsignedInt
  id_client   Int?     @db.UnsignedInt
  entity_type String   @db.VarChar(50)
  entity_id   Int      @db.UnsignedInt
  vc_folio    String?  @db.VarChar(50)
  bucket_path String   @db.VarChar(500)
  vc_url      String   @db.VarChar(500)
  vc_mime     String?  @db.VarChar(100)
  i_size      Int?
  id_user     Int?     @db.UnsignedInt
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamp(0)

  @@index([id_client, entity_type, entity_id, is_active], map: "idx_assets_entity")
}

model cities {
  id         Int         @id @default(autoincrement()) @db.UnsignedInt
  id_country Int         @db.UnsignedInt
  id_state   Int         @db.UnsignedInt
  name       String      @db.VarChar(100)
  is_active  Boolean     @default(true)
  created_at DateTime    @default(now()) @db.Timestamp(0)
  updated_at DateTime    @default(now()) @db.Timestamp(0)
  addresses  addresses[]
  country    countries   @relation(fields: [id_country], references: [id])
  state      states      @relation(fields: [id_state], references: [id])

  @@index([id_country], map: "cities_id_country_fkey")
  @@index([id_state], map: "cities_id_state_fkey")
}

model client_logs {
  id_cliente_log Int      @id @default(autoincrement()) @db.UnsignedInt
  id_client      Int      @db.UnsignedInt
  id_user        Int      @db.UnsignedInt
  log            String   @db.VarChar(1000)
  i_status       Int      @default(1) @db.TinyInt
  dt_register    DateTime @default(now()) @db.Timestamp(0)
  dt_updated     DateTime @default(now()) @db.Timestamp(0)
  clients        clients  @relation(fields: [id_client], references: [id_client], map: "fk_logs_client")
  users          users    @relation(fields: [id_user], references: [id_user], map: "fk_logs_client_user")

  @@index([id_client], map: "fk_logs_client")
  @@index([id_user], map: "idx_client_logs_user")
}

model clients {
  id_client               Int                @id @default(autoincrement()) @db.UnsignedInt
  id_user                 Int                @db.UnsignedInt
  name                    String?            @db.VarChar(100)
  vc_initialism           String             @db.VarChar(20)
  i_status                Int                @default(1) @db.TinyInt
  dt_register             DateTime           @default(now()) @db.Timestamp(0)
  dt_updated              DateTime           @default(now()) @db.Timestamp(0)
  rfc                     String             @default("") @db.VarChar(15)
  email                   String             @default("") @db.VarChar(255)
  address                 String             @default("") @db.VarChar(255)
  city                    String             @default("") @db.VarChar(255)
  adiccional_notes        String?            @db.Text
  phone                   String             @default("") @db.VarChar(20)
  vc_url_situacion_fiscal String?            @db.VarChar(500)
  client_logs             client_logs[]
  drivers                 drivers[]
  users                   users              @relation(fields: [id_user], references: [id_user], map: "fk_clients_user")
  orders                  orders[]
  products                products[]
  questions_client        questions_client[]
  requests                requests[]
  tasks                   tasks[]
  folios                  folios[]
  client_charges          client_charges[]
  client_stores           client_stores[]

  @@index([i_status], map: "idx_clients_status")
  @@index([id_user], map: "idx_clients_user")
}

model countries {
  id         Int         @id @default(autoincrement()) @db.UnsignedInt
  name       String      @db.VarChar(100)
  phone_code String      @db.VarChar(10)
  is_active  Boolean     @default(true)
  created_at DateTime    @default(now()) @db.Timestamp(0)
  updated_at DateTime    @default(now()) @db.Timestamp(0)
  addresses  addresses[]
  cities     cities[]
  states     states[]
}

model order_logs {
  id_order_log Int      @id @default(autoincrement()) @db.UnsignedInt
  id_order     Int      @default(0) @db.UnsignedInt
  id_usuario   Int      @default(0) @db.UnsignedInt
  id_promotor  Int      @default(0) @db.UnsignedInt
  id_negocio   Int      @default(0) @db.UnsignedInt
  id_pais      Int      @default(0) @db.UnsignedInt
  vc_log       String   @db.VarChar(500)
  i_status     Int      @default(1) @db.TinyInt
  dt_registro  DateTime @default(now()) @db.Timestamp(0)
  order        orders   @relation(fields: [id_order], references: [id_order])

  @@index([id_negocio], map: "idx_negocio")
  @@index([id_order], map: "idx_order")
  @@index([id_usuario], map: "idx_usuario")
}

model orders {
  id_order       Int              @id @default(autoincrement()) @db.UnsignedInt
  id_user        Int              @db.UnsignedInt
  id_client      Int              @db.UnsignedInt
  vc_folio       String?          @unique(map: "uq_orders_folio") @db.VarChar(50)
  f_total        Decimal          @db.Decimal(10, 2)
  dt_register    DateTime         @db.DateTime(0)
  dt_update      DateTime         @db.DateTime(0)
  id_status      Int              @default(1)
  order_items    order_items[]
  order_logs     order_logs[]
  order_requests order_requests[]
  client         clients          @relation(fields: [id_client], references: [id_client])
  user           users            @relation(fields: [id_user], references: [id_user])
  tasks          tasks[]
  charge_orders  client_charge_orders[]

  @@index([id_client], map: "orders_id_client_fkey")
  @@index([id_user], map: "orders_id_user_fkey")
}

model order_requests {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  id_order    Int      @db.UnsignedInt
  id_request  Int      @db.UnsignedInt
  id_status   Int?
  dt_register DateTime @default(now()) @db.Timestamp(0)
  dt_update   DateTime @updatedAt @db.Timestamp(0)
  order       orders   @relation(fields: [id_order], references: [id_order])
  request     requests @relation(fields: [id_request], references: [id_request])

  @@unique([id_order, id_request])
  @@index([id_order])
  @@index([id_request])
}

model order_items {
  id_order_item Int      @id @default(autoincrement()) @db.UnsignedInt
  id_order      Int      @db.UnsignedInt
  id_request    Int      @db.UnsignedInt
  id_store      Int      @db.UnsignedInt
  f_value       Decimal  @db.Decimal(10, 2)
  dt_register   DateTime @default(now()) @db.Timestamp(0)
  dt_update     DateTime @default(now()) @db.Timestamp(0)
  order         orders   @relation(fields: [id_order], references: [id_order])
  request       requests @relation(fields: [id_request], references: [id_request])
  store         stores   @relation(fields: [id_store], references: [id_store])

  @@index([id_order], map: "idx_order_items_order")
  @@index([id_request], map: "idx_order_items_request")
  @@index([id_store], map: "idx_order_items_store")
}

model product_logs {
  id_product_log Int       @id @default(autoincrement())
  id_product     Int
  id_usuario     Int       @default(0) @db.UnsignedInt
  id_promotor    Int       @default(0) @db.UnsignedInt
  id_negocio     Int       @default(0) @db.UnsignedInt
  id_pais        Int       @default(0) @db.UnsignedInt
  vc_log         String    @default("") @db.VarChar(500)
  i_status       Boolean?  @default(true)
  dt_register    DateTime? @default(now()) @db.DateTime(0)
  dt_updated     DateTime? @updatedAt @db.Timestamp(0)
}

model products {
  id_product        Int                @id @default(autoincrement())
  id_user           Int                @db.UnsignedInt
  id_client         Int                @db.UnsignedInt
  vc_folio          String?            @unique(map: "uq_products_folio") @db.VarChar(50)
  name              String             @db.VarChar(255)
  description       String?            @db.Text
  vc_image          String?            @db.VarChar(500)
  /// Codigo (SKU o numero de codigo de barras) que el cliente escribe para
  /// este producto. Se usa para que el promotor confirme, escaneando con
  /// la camara, que tiene enfrente el producto correcto antes de revisarlo.
  vc_sku            String?            @db.VarChar(100)
  /// Foto del codigo de barras/QR que subio el cliente. Es solo de
  /// referencia visual para el cliente en el panel -- el promotor nunca la
  /// ve ni se usa para comparar, la comparacion real es contra vc_sku.
  vc_barcode_image  String?            @db.VarChar(500)
  i_status          Int?               @default(1) @db.TinyInt
  /// Piezas disponibles ahora mismo. NULL = el cliente no maneja stock para
  /// este producto (se surte sin restriccion, comportamiento de antes).
  i_stock           Int?               @db.UnsignedInt
  /// Si esta prendido, cuando un pedido pide mas piezas de las que hay en
  /// i_stock, el faltante se puede surtir despues (backorder) en vez de
  /// simplemente topar al stock disponible.
  b_allow_backorder Boolean            @default(false)
  /// Dias que tarda en surtirse el faltante cuando b_allow_backorder esta
  /// prendido (ej. 20 o 30 dias, lo que el cliente decida).
  i_backorder_days  Int?               @db.UnsignedSmallInt
  /// Costo que se le cobra a la tienda por este producto (para que el dueño
  /// del negocio sepa cuanto va a pagar por su pedido). Distinto del costo
  /// de las preguntas del checklist.
  f_store_price     Decimal?           @db.Decimal(10, 2)
  dt_created        DateTime?          @default(now()) @db.Timestamp(0)
  dt_updated        DateTime?          @default(now()) @updatedAt @db.Timestamp(0)
  client            clients            @relation(fields: [id_client], references: [id_client])
  request_products  request_products[]
  stock_minimums    product_stock_minimums[]
  stock_readings    store_product_stock[]
  preorder_items    task_preorder_items[]
  delivery_stop_items delivery_stop_items[]

  @@index([id_client], map: "products_id_client_fkey")
}

model promoter_logs {
  id_promoter_log Int      @id @default(autoincrement()) @db.UnsignedInt
  id_promotor     Int      @default(0) @db.UnsignedInt
  id_usuario      Int      @default(0) @db.UnsignedInt
  id_negocio      Int      @default(0) @db.UnsignedInt
  id_pais         Int      @default(0) @db.UnsignedInt
  vc_log          String   @db.VarChar(500)
  i_status        Int      @default(1) @db.TinyInt
  dt_registro     DateTime @default(now()) @db.Timestamp(0)

  @@index([id_negocio], map: "idx_negocio")
  @@index([id_promotor], map: "idx_promotor")
  @@index([id_usuario], map: "idx_usuario")
}

model promoters {
  id            Int       @id @default(autoincrement()) @db.UnsignedInt
  name          String    @db.VarChar(255)
  lastname      String?   @db.VarChar(255)
  email         String?   @unique(map: "vc_email") @db.VarChar(255)
  password      String    @db.VarChar(255)
  phone         String    @unique(map: "vc_phone") @db.VarChar(20)
  fcm_token     String?   @db.VarChar(255)
  dt_register   DateTime  @db.DateTime(0)
  dt_updated    DateTime  @default(now()) @db.Timestamp(0)
  dt_last_login DateTime? @db.DateTime(0)
  isActive      Boolean   @default(true)
  /// Codigo de 6 digitos + expiracion para "olvide mi contraseña" (se manda
  /// por correo, ya que el login del promotor es por telefono y no siempre
  /// tiene correo registrado). Si no tiene correo, no puede autoservirse y
  /// el admin debe restablecerla desde el panel (ver PromoterDetalle).
  reset_password_code    String?   @db.VarChar(6)
  reset_password_expires DateTime? @db.Timestamp(0)
  /// Fecha en que el promotor acepto los Terminos y Condiciones / Aviso de
  /// Privacidad al registrarse. Sirve como evidencia real de consentimiento
  /// (no basta con un checkbox visual del lado del cliente que se pueda
  /// evadir); se exige y valida del lado del servidor en createPromoter.
  dt_terms_accepted DateTime? @db.Timestamp(0)
  /// Baja de cuenta solicitada por el promotor (borrado hibrido, requisito
  /// de Google Play). El telefono NO se borra para conservar el
  /// identificador historico y la integridad contable de tareas/pagos ya
  /// realizados; en su lugar, se marca esta fecha y se revocan sus sesiones.
  dt_deleted    DateTime? @db.Timestamp(0)
  latitude      Decimal?  @db.Decimal(10, 8)
  longitude     Decimal?  @db.Decimal(11, 8)
  vc_referral_code String? @unique(map: "uq_promoters_referral_code") @db.VarChar(20)
  id_activator     Int?    @db.UnsignedInt
  /// Switch global de "INFO" que ve el promotor arriba en todas las
  /// pantallas (junto a su foto de perfil). Prende/apaga a la vez los 5
  /// videos de introduccion (ver intro_video_clips); no es por seccion.
  b_show_intro_videos Boolean @default(true)
  /// Genero del promotor, elegido por el mismo desde su perfil en la app.
  /// Se usa para elegir el avatar del asistente de "Dudas?" (se le muestra
  /// una mujer si es hombre, un hombre si es mujer). Null hasta que lo capture.
  vc_gender String? @db.VarChar(1)
  tasks                  tasks[]
  promoter_bank_accounts promoter_bank_accounts[]
  payments               promoter_payments[]
  activator            promoters?  @relation("PromoterActivator", fields: [id_activator], references: [id])
  activated_promoters  promoters[] @relation("PromoterActivator")
  activator_payments   activator_payments[]

  @@index([id_activator], map: "idx_promoters_activator")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model question_client_logs {
  id_question_client_log Int              @id @default(autoincrement()) @db.UnsignedInt
  id_question_client     Int              @db.UnsignedInt
  id_user                Int              @db.UnsignedInt
  log                    String           @db.VarChar(1000)
  i_status               Int              @default(1) @db.TinyInt
  dt_register            DateTime         @default(now()) @db.Timestamp(0)
  dt_updated             DateTime         @default(now()) @updatedAt @db.Timestamp(0)
  questions_client       questions_client @relation(fields: [id_question_client], references: [id_question_client], map: "fk_question_client_logs_question_client")
  users                  users            @relation(fields: [id_user], references: [id_user], map: "fk_question_client_logs_user")

  @@index([id_question_client], map: "fk_question_client_logs_question_client")
  @@index([id_user], map: "fk_question_client_logs_user")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model question_logs {
  id_question_log Int       @id @default(autoincrement()) @db.UnsignedInt
  id_question     Int       @db.UnsignedInt
  id_user         Int       @db.UnsignedInt
  log             String    @db.VarChar(1000)
  i_status        Int       @default(1) @db.TinyInt
  dt_register     DateTime  @default(now()) @db.Timestamp(0)
  dt_updated      DateTime  @default(now()) @db.Timestamp(0)
  questions       questions @relation(fields: [id_question], references: [id_question], map: "fk_logs_question")
  users           users     @relation(fields: [id_user], references: [id_user], map: "fk_logs_question_user")

  @@index([id_question], map: "fk_logs_question")
  @@index([id_user], map: "fk_logs_question_user")
}

model question_options {
  id_option            Int       @id @default(autoincrement()) @db.UnsignedInt
  id_question          Int       @db.UnsignedInt
  option_text          String    @db.VarChar(255)
  option_value_numeric Decimal?  @db.Decimal(10, 2)
  option_value_text    String?   @db.VarChar(100)
  option_order         Int?      @default(0)
  i_status             Boolean?  @default(true)
  dt_register          DateTime? @default(now()) @db.DateTime(0)
  dt_updated           DateTime? @default(now()) @updatedAt @db.DateTime(0)
  questions            questions @relation("QuestionOptions", fields: [id_question], references: [id_question], map: "fk_option_question")

  @@index([id_question], map: "fk_option_question")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model questions {
  id_question               Int                         @id @default(autoincrement()) @db.UnsignedInt
  id_user                   Int                         @db.UnsignedInt
  question                  String                      @db.VarChar(1000)
  f_cost                    Decimal                     @default(0) @db.Decimal(10, 2)
  i_status                  Int                         @default(1) @db.TinyInt
  dt_register               DateTime                    @default(now()) @db.Timestamp(0)
  dt_updated                DateTime                    @default(now()) @updatedAt @db.Timestamp(0)
  question_type             String?                     @default("open") @db.VarChar(20)
  min_value                 Decimal?                    @db.Decimal(10, 2)
  max_value                 Decimal?                    @db.Decimal(10, 2)
  max_photos                Int?                        @default(1)
  /// Marca la pregunta unica de sistema "¿Cuantas piezas hay en existencia?"
  /// que se agrega automaticamente (gratis) a todo producto de toda
  /// solicitud, para poder alimentar el mapa de inventario del cliente.
  /// No la crea el cliente; ver requests.service.ts getOrCreateStockQuestion.
  b_stock_question           Boolean                     @default(false)
  question_logs             question_logs[]
  question_options          question_options[]          @relation("QuestionOptions")
  users                     users                       @relation(fields: [id_user], references: [id_user], map: "fk_question_user")
  questions_client          questions_client[]
  request_product_questions request_product_questions[]

  @@index([id_user], map: "fk_question_user")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model questions_client {
  id_question_client   Int                    @id @default(autoincrement()) @db.UnsignedInt
  id_question          Int                    @db.UnsignedInt
  id_client            Int                    @db.UnsignedInt
  id_user              Int                    @db.UnsignedInt
  i_status             Int                    @default(1) @db.TinyInt
  dt_register          DateTime               @default(now()) @db.Timestamp(0)
  dt_updated           DateTime               @default(now()) @updatedAt @db.Timestamp(0)
  question_client_logs question_client_logs[]
  clients              clients                @relation(fields: [id_client], references: [id_client], map: "fk_question_client_client")
  questions            questions              @relation(fields: [id_question], references: [id_question], map: "fk_question_client_question")
  users                users                  @relation(fields: [id_user], references: [id_user], map: "fk_question_client_user")

  @@index([id_client], map: "fk_question_client_client")
  @@index([id_question], map: "fk_question_client_question")
  @@index([id_user], map: "fk_question_client_user")
}

model request_logs {
  id_request_log Int      @id @default(autoincrement()) @db.UnsignedInt
  id_request     Int      @default(0) @db.UnsignedInt
  id_usuario     Int      @default(0) @db.UnsignedInt
  id_promotor    Int      @default(0) @db.UnsignedInt
  id_negocio     Int      @default(0) @db.UnsignedInt
  id_pais        Int      @default(0) @db.UnsignedInt
  vc_log         String   @db.VarChar(500)
  i_status       Int      @default(1) @db.TinyInt
  dt_registro    DateTime @default(now()) @db.Timestamp(0)

  @@index([id_negocio], map: "idx_negocio")
  @@index([id_request], map: "idx_request")
  @@index([id_usuario], map: "idx_usuario")
}

model request_product_questions {
  id_request_product_question Int              @id @default(autoincrement()) @db.UnsignedInt
  id_request_product          Int              @db.UnsignedInt
  id_question                 Int              @db.UnsignedInt
  dt_register                 DateTime         @default(now()) @db.Timestamp(0)
  dt_update                   DateTime         @default(now()) @db.Timestamp(0)
  b_active                    Boolean          @default(true)
  question                    questions        @relation(fields: [id_question], references: [id_question])
  request_product             request_products @relation(fields: [id_request_product], references: [id_request_product])

  @@index([id_request_product], map: "idx_request_product_question_rp")
  @@index([id_question], map: "idx_request_product_question_question")
}

model request_products {
  id_request_product        Int                         @id @default(autoincrement()) @db.UnsignedInt
  id_request                Int                         @db.UnsignedInt
  id_product                Int
  dt_register               DateTime                    @default(now()) @db.Timestamp(0)
  dt_update                 DateTime                    @default(now()) @db.Timestamp(0)
  b_active                  Boolean                     @default(true)
  request_product_questions request_product_questions[]
  product                   products                    @relation(fields: [id_product], references: [id_product])
  request                   requests                    @relation(fields: [id_request], references: [id_request])

  @@unique([id_request, id_product], map: "uq_request_product")
  @@index([id_request], map: "idx_request_products_request")
  @@index([id_product], map: "idx_request_products_product")
}

model requests {
  id_request       Int                @id @default(autoincrement()) @db.UnsignedInt
  id_user          Int                @db.UnsignedInt
  id_client        Int                @db.UnsignedInt
  vc_folio         String?            @unique(map: "uq_requests_folio") @db.VarChar(50)
  vc_name          String             @db.VarChar(255)
  f_value          Decimal            @db.Decimal(10, 2)
  dt_register      DateTime           @default(now()) @db.Timestamp(0)
  dt_update        DateTime           @default(now()) @db.Timestamp(0)
  id_status        Int                @default(1)
  b_active         Boolean            @default(true)
  /// Extra "Prepedido": si esta activo, al terminar su conteo de piezas el
  /// promotor puede levantar un pedido con el encargado de la tienda por lo
  /// que le falte contra el minimo configurado, y mandarselo por WhatsApp.
  b_preorder       Boolean            @default(false)
  /// Solo aplica si b_preorder es true. 'ABIERTA': el encargado de la tienda
  /// elige la fecha/turno de entrega. 'CERRADA': se asigna automaticamente
  /// segun la ruta del cliente.
  preorder_date_mode String           @default("ABIERTA") @db.VarChar(10)
  url_rack_image   String?            @db.VarChar(500)
  order_items      order_items[]
  order_requests   order_requests[]
  request_products request_products[]
  client           clients            @relation(fields: [id_client], references: [id_client])
  tasks            tasks[]

  @@index([id_client], map: "requests_id_client_fkey")
}

model states {
  id         Int         @id @default(autoincrement()) @db.UnsignedInt
  id_country Int         @db.UnsignedInt
  name       String      @db.VarChar(100)
  is_active  Boolean     @default(true)
  created_at DateTime    @default(now()) @db.Timestamp(0)
  updated_at DateTime    @default(now()) @db.Timestamp(0)
  addresses  addresses[]
