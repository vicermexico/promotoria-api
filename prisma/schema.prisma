// NOTA: sin @relation a `tasks`/`promoters` a propósito. id_task/id_promoter
// aquí son int(11) con signo, mientras que tasks.id_task y promoters.id son
// int unsigned — MySQL no permite crear una FK real entre tipos con
// signedness distinto (errno 150), y cambiar el tipo de esas columnas en
// producción es más riesgo del que vale la pena. Si se declara la relación,
// `db push`/`migrate` van a intentar crear la FK en cada corrida y van a
// tronar aquí. El join tienda/solicitud se hace a mano en
// tasks.service.ts:getPromoterTaskHistory con una query aparte.
model task_rejections {
  id_rejection Int       @id @default(autoincrement())
  id_task      Int
  id_promoter  Int
  /// 'rejected' = el promotor rechazó la oferta; 'timeout' = se le desvinculó
  /// automáticamente por no iniciar la tarea a tiempo tras "en camino".
  reason       String    @default("rejected") @db.VarChar(20)
  dt_register  DateTime? @default(now()) @db.DateTime(0)

  @@unique([id_task, id_promoter], map: "uq_task_promoter")
  @@index([id_task], map: "idx_task_rejections_task")
  @@index([id_promoter], map: "idx_task_rejections_promoter")
}

/// Pedido acordado entre el promotor y el encargado/dueño de la tienda,
/// cuando la solicitud tiene el extra "Prepedido" activado (b_preorder).
/// Se levanta cuando, tras el conteo de piezas, hay faltante contra el
/// minimo configurado por el cliente para esa tienda/producto.
model task_preorders {
  id_preorder       Int      @id @default(autoincrement()) @db.UnsignedInt
  id_task           Int      @db.UnsignedInt @unique
  /// Numero de WhatsApp del encargado/dueño de la tienda (no del cliente
  /// empresarial) — es a quien se le manda el mensaje con el pedido.
  manager_whatsapp  String   @db.VarChar(20)
  /// Firma electronica del encargado/dueño, capturada en pantalla y
  /// guardada como imagen (ver StorageService).
  manager_signature String   @db.VarChar(500)
  /// Fecha en la que el encargado/dueño pidio que le entreguen el pedido.
  preferred_date    DateTime @db.Date
  /// 'MAÑANA' o 'TARDE' — turno de entrega preferido.
  preferred_time    String   @db.VarChar(10)
  /// 0 = sin surtir (recien levantado, todavia no se entrega), 1 = surtido
  /// (ya se le entrego la mercancia a la tienda).
  id_status         Int      @default(0) @db.TinyInt
  dt_register       DateTime @default(now()) @db.Timestamp(0)
  dt_updated        DateTime @default(now()) @updatedAt @db.Timestamp(0)
  task              tasks    @relation(fields: [id_task], references: [id_task])
  items             task_preorder_items[]
  delivery_stops    delivery_route_stops[]
}

/// Renglones del pedido acordado: cuanto de cada producto se va a surtir.
model task_preorder_items {
  id_item              Int             @id @default(autoincrement()) @db.UnsignedInt
  id_preorder          Int             @db.UnsignedInt
  id_product           Int
  i_quantity           Int
  /// Cuanto de i_quantity se surte de inmediato (con el stock disponible en
  /// ese momento). Si el producto no maneja stock, o alcanza el stock
  /// completo, esto es igual a i_quantity.
  i_quantity_immediate Int?
  /// Cuanto de i_quantity queda pendiente por surtir despues (backorder).
  /// NULL o 0 si no aplico backorder para este renglon.
  i_quantity_backorder Int?
  /// Dias de entrega prometidos para i_quantity_backorder (copiado del
  /// producto al momento de crear el prepedido, para que quede fijo aunque
  /// el cliente cambie despues la configuracion del producto).
  i_backorder_days     Int?
  preorder             task_preorders  @relation(fields: [id_preorder], references: [id_preorder])
  product              products        @relation(fields: [id_product], references: [id_product])

  @@index([id_preorder], map: "idx_preorder_item_preorder")
}

