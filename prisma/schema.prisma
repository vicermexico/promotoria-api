  bank_name           String                @db.VarChar(255)
  dt_register         DateTime              @default(now()) @db.Timestamp(0)
  dt_updated          DateTime              @default(now()) @updatedAt @db.Timestamp(0)
  dt_deleted          DateTime?             @db.Timestamp(0)
  promoter            promoters             @relation(fields: [id_promoter], references: [id])

  @@index([id_promoter], map: "idx_promoter_bank_accounts_promoter")
}

// ==================== LOGISTICA / CHOFERES ====================

model drivers {
  id_driver      Int              @id @default(autoincrement()) @db.UnsignedInt
  id_client      Int              @db.UnsignedInt
  name           String           @db.VarChar(150)
  phone          String           @db.VarChar(20)
  email          String?          @db.VarChar(255)
  password_hash  String           @db.VarChar(255)
  vc_photo       String?          @db.VarChar(500)
  /// Ubicacion mas reciente del chofer, para poder ordenar su lista de
  /// entregas de la mas cercana a la mas lejana.
  latitude       Decimal?         @db.Decimal(10, 8)
  longitude      Decimal?         @db.Decimal(11, 8)
  dt_location_updated DateTime?   @db.Timestamp(0)
  i_status       Int              @default(1) @db.TinyInt
  /// El master/cliente reseteo la contraseña (queda en "1234") y el chofer
  /// debe poner una nueva antes de poder usar el resto del panel.
  must_change_password Boolean    @default(false)
  dt_register    DateTime         @default(now()) @db.Timestamp(0)
  dt_updated     DateTime         @default(now()) @updatedAt @db.Timestamp(0)
  client         clients          @relation(fields: [id_client], references: [id_client])
  routes         delivery_routes[]
  route_schedules route_driver_schedules[]

  @@index([id_client], map: "idx_drivers_client")
}

model delivery_routes {
  id_route    Int                    @id @default(autoincrement()) @db.UnsignedInt
  id_client   Int                    @db.UnsignedInt
  id_driver   Int                    @db.UnsignedInt
  route_date  DateTime               @db.Date
  /// Horario real de cada turno para esta ruta (ej. "10:00" a "13:00"),
  /// se define cada vez que se arma la ruta. Null = no se especifico.
  manana_inicio String?              @db.VarChar(5)
  manana_fin    String?              @db.VarChar(5)
  tarde_inicio  String?              @db.VarChar(5)
  tarde_fin     String?              @db.VarChar(5)
  /// El cliente puede desactivar una ruta ya organizada (por ejemplo, si ya
  /// no se va a usar) sin borrar su historial -- asi sabe la ultima vez
  /// que se uso con solo ver route_date. Si viene de una asignacion
  /// automatica (id_schedule), el propio sistema la activa/desactiva sola.
  is_active   Boolean                @default(true)
  /// Si esta ruta se genero (o se organizo con "repetir automatico") desde
  /// una asignacion recurrente, aqui queda la referencia -- sirve para
  /// mostrar la frecuencia en "Rutas Creadas" y para la activacion/
  /// desactivacion automatica.
  id_schedule Int?                   @db.UnsignedInt
  /// A que ruta reutilizable (nombre + tiendas) pertenece esta ruta ya
  /// organizada -- se guarda SIEMPRE, se repita automatico o no, para que
  /// el nombre aparezca en "Rutas Creadas" y para poder adjuntarla despues.
  id_route_template Int?             @db.UnsignedInt
  dt_register DateTime               @default(now()) @db.Timestamp(0)
  driver      drivers                @relation(fields: [id_driver], references: [id_driver])
  schedule    route_driver_schedules? @relation(fields: [id_schedule], references: [id_schedule])
  route_template route_templates?    @relation(fields: [id_route_template], references: [id_route_template])
  stops       delivery_route_stops[]

  @@index([id_client], map: "idx_delivery_routes_client")
  @@index([id_driver], map: "idx_delivery_routes_driver")
  @@index([id_schedule], map: "idx_delivery_routes_schedule")
}

model delivery_route_stops {
  id_stop              Int             @id @default(autoincrement()) @db.UnsignedInt
  id_route             Int             @db.UnsignedInt
  id_store             Int             @db.UnsignedInt
  /// 'MAÑANA' o 'TARDE' -- turno en el que se visita esta tienda dentro
  /// de ESTA ruta especifica (se etiqueta cada vez que se arma la ruta).
  turno                String          @default("MAÑANA") @db.VarChar(10)
  /// Puede no haber pedido — algunas visitas son solo de revision/entrega
  /// general, sin un prepedido especifico detras.
  id_preorder          Int?            @db.UnsignedInt
  /// Orden dentro de la ruta (1, 2, 3...) — en modo lista se calcula del
  /// mas cercano al chofer al mas lejano; en modo mapa, el orden en el que
  /// el usuario fue palomeando las tiendas.
  i_order              Int
  /// 0 = por visitar, 1 = visitada
  i_status             Int             @default(0) @db.TinyInt
  /// Si ya se visito: si se dejo mercancia o no, y por que no si aplica.
  b_delivered          Boolean?
  vc_no_delivery_reason String?        @db.VarChar(500)
  /// true si la mercancia se dejo a consignacion (no se cobro nada al
  /// momento de la entrega).
  b_consigna           Boolean         @default(false)
  /// Cuanto se cobro en efectivo y cuanto por transferencia — pueden venir
  /// los dos a la vez si el pago se dividio.
  f_amount_cash        Decimal?        @db.Decimal(10, 2)
  f_amount_transfer    Decimal?        @db.Decimal(10, 2)
  /// Valor total de lo entregado, calculado con el precio a tienda de cada
  /// producto (delivery_stop_items) al momento de la entrega.
  f_total_charged      Decimal?        @db.Decimal(10, 2)
  dt_visited           DateTime?       @db.Timestamp(0)
  dt_register          DateTime        @default(now()) @db.Timestamp(0)
  route                delivery_routes @relation(fields: [id_route], references: [id_route])
  store                stores          @relation(fields: [id_store], references: [id_store])
  preorder             task_preorders? @relation(fields: [id_preorder], references: [id_preorder])
  items                delivery_stop_items[]

  @@index([id_route], map: "idx_delivery_stops_route")
  @@index([id_preorder], map: "idx_delivery_stops_preorder")
}

/// Que productos (y cuantos) se dejaron realmente en una parada de la
/// ruta -- puede no coincidir exacto con lo que decia el prepedido
/// original (sustituciones, faltantes, etc). f_unit_price guarda el
/// precio a tienda del producto al momento de la entrega, para que el
/// historial no cambie si despues se actualiza el precio del producto.
model delivery_stop_items {
  id_item     Int                  @id @default(autoincrement()) @db.UnsignedInt
  id_stop     Int                  @db.UnsignedInt
  id_product  Int
  i_quantity  Int
  f_unit_price Decimal             @db.Decimal(10, 2)
  stop        delivery_route_stops @relation(fields: [id_stop], references: [id_stop])
  product     products             @relation(fields: [id_product], references: [id_product])

  @@index([id_stop], map: "idx_delivery_stop_items_stop")
}

/// Textos configurables del sistema que el master puede editar sin
/// necesitar una actualizacion de la app o del panel (ej. el mensaje de
/// instrucciones que ve el promotor al aceptar una tarea).
model app_settings {
  id_setting  Int      @id @default(autoincrement()) @db.UnsignedInt
  vc_key      String   @unique @db.VarChar(100)
  vc_value    String   @db.Text
  dt_updated  DateTime @default(now()) @updatedAt @db.Timestamp(0)
}

/// Clips crudos (fondo verde, sin procesar) que el master sube por cada uno
/// de los 5 "checkpoints" del video de introduccion (ver
/// IntroVideosService.CHECKPOINTS para las llaves validas de vc_checkpoint_key:
/// fotos_antes, fotos_post_foto1, fotos_post_foto2, preguntas, preventa).
/// Puede haber varios clips por checkpoint, ordenados por i_order; se pegan
/// en un solo video (ffmpeg) cuyo resultado se guarda en app_settings bajo
/// la llave `intro_video_processed_<checkpoint_key>` (fuera de esta tabla
/// para no duplicar tabla de "1 valor" que app_settings ya resuelve).
model intro_video_clips {
  id_clip           Int      @id @default(autoincrement()) @db.UnsignedInt
  vc_checkpoint_key String   @db.VarChar(50)
  vc_url            String   @db.VarChar(500)
  vc_bucket_path    String   @db.VarChar(500)
  i_order           Int      @default(0)
  dt_register       DateTime @default(now()) @db.Timestamp(0)

  @@index([vc_checkpoint_key, i_order], map: "idx_intro_video_clips_checkpoint")
}

/// Ruta reutilizable que el cliente arma una vez (nombre + tiendas + con que
/// frecuencia se repite), para no tener que buscar tienda por tienda cada
/// vez que organiza una ruta de entrega. Al "Organizar ruta" en Logistica,
/// puede adjuntar una de estas para que le rellene las tiendas de una vez.
model route_templates {
  id_route_template Int      @id @default(autoincrement()) @db.UnsignedInt
  id_client         Int      @db.UnsignedInt
  name              String   @db.VarChar(150)
  dt_register       DateTime @default(now()) @db.Timestamp(0)
  dt_updated        DateTime @default(now()) @updatedAt @db.Timestamp(0)
  stores            route_template_stores[]
  schedules         route_driver_schedules[]
  routes            delivery_routes[]

  @@index([id_client], map: "idx_route_templates_client")
}

model route_template_stores {
  id_route_template_store Int              @id @default(autoincrement()) @db.UnsignedInt
  id_route_template       Int              @db.UnsignedInt
  id_store                Int              @db.UnsignedInt
  /// 'MAÑANA' o 'TARDE' -- turno en el que se visita esta tienda dentro
  /// de la ruta. Default MAÑANA para no romper tiendas ya guardadas.
  turno                   String           @default("MAÑANA") @db.VarChar(10)
  route_template          route_templates  @relation(fields: [id_route_template], references: [id_route_template], onDelete: Cascade)

  @@unique([id_route_template, id_store], map: "uq_route_template_store")
  @@index([id_route_template], map: "idx_route_template_stores_template")
}

/// Asigna una ruta (route_templates) a un chofer para que se le genere sola
/// cada cierto tiempo, en vez de que el cliente tenga que entrar cada
/// semana a organizarla a mano. Se crea desde "Organizar Ruta" al marcar
/// "repetir automatico". Un worker revisa esta tabla a diario.
model route_driver_schedules {
  id_schedule       Int              @id @default(autoincrement()) @db.UnsignedInt
  id_client         Int              @db.UnsignedInt
  id_route_template Int              @db.UnsignedInt
  id_driver         Int              @db.UnsignedInt
  /// 1=lunes ... 7=domingo
  day_of_week       Int              @db.TinyInt
  /// Cada cuantas semanas se repite: 1=cada semana, 2=cada 2, 3=cada 3, 4=cada 4
  interval_weeks    Int              @db.TinyInt
  /// Semana de referencia para contar el intervalo (la fecha en que se creo
  /// la primer ruta de esta asignacion). No cambia aunque pasen las semanas.
  anchor_date       DateTime         @db.Date
  /// Turno de la visita en este dia: 'MANANA' o 'TARDE'
  turno             String           @default("MANANA") @db.VarChar(10)
  is_active         Boolean          @default(true)
  dt_register       DateTime         @default(now()) @db.Timestamp(0)
  route_template    route_templates  @relation(fields: [id_route_template], references: [id_route_template], onDelete: Cascade)
  driver            drivers          @relation(fields: [id_driver], references: [id_driver])
  routes            delivery_routes[]

  @@index([id_client], map: "idx_route_schedules_client")
  @@index([id_route_template], map: "idx_route_schedules_template")
}


/// Pantalla de la app registrada por el master para poder senalar botones
/// sobre ella en las respuestas de "Dudas?". Cada pantalla tiene una foto
/// (screenshot) subida por el master y, sobre ella, los botones marcados
/// (ver faq_screen_elements).
model faq_screens {
  id_faq_screen             Int      @id @default(autoincrement()) @db.UnsignedInt
  vc_screen_key             String   @unique @db.VarChar(100)
  vc_title                  String   @db.VarChar(150)
  vc_screenshot_url         String   @db.VarChar(500)
  vc_screenshot_bucket_path String   @db.VarChar(500)
  vc_app_route              String?  @db.VarChar(100)
  dt_register               DateTime @default(now()) @db.Timestamp(0)
  dt_updated                DateTime @default(now()) @updatedAt @db.Timestamp(0)
  elements                  faq_screen_elements[]
}

/// Un boton/elemento marcado por el master sobre la foto de una pantalla
/// (faq_screens), con el rectangulo donde aparece (en porcentaje, para que
/// no dependa de la resolucion de pantalla). vc_element_key debe coincidir
/// con la llave real que tiene ese boton en el codigo de la app (Flutter),
/// para poder resaltarlo de verdad cuando se usa en un paso (ver
/// faq_highlight_steps).
model faq_screen_elements {
  id_faq_screen_element Int      @id @default(autoincrement()) @db.UnsignedInt
  id_faq_screen         Int      @db.UnsignedInt
  vc_element_key        String   @db.VarChar(100)
  vc_label              String   @db.VarChar(150)
  f_x                   Float
  f_y                   Float
  f_width               Float
  f_height              Float
  vc_direction          String?  @db.VarChar(20)
  f_rotation_deg        Float    @default(0)
  dt_register           DateTime @default(now()) @db.Timestamp(0)
  screen                faq_screens @relation(fields: [id_faq_screen], references: [id_faq_screen], onDelete: Cascade)
  steps                 faq_highlight_steps[]

  @@unique([id_faq_screen, vc_element_key], map: "uq_faq_screen_element_key")
}

/// Pregunta frecuente armada por el master: una respuesta con varias
/// formas distintas de preguntarla (faq_question_phrases) para que el
/// promotor la encuentre escriba como escriba, y opcionalmente una
/// secuencia de botones a resaltar (faq_highlight_steps).
model faq_questions {
  id_faq_question Int      @id @default(autoincrement()) @db.UnsignedInt
  vc_answer_text  String   @db.Text
  i_status        Int      @default(1) @db.TinyInt
  dt_register     DateTime @default(now()) @db.Timestamp(0)
  dt_updated      DateTime @default(now()) @updatedAt @db.Timestamp(0)
  phrases         faq_question_phrases[]
  steps           faq_highlight_steps[]
}

model faq_question_phrases {
  id_faq_question_phrase Int      @id @default(autoincrement()) @db.UnsignedInt
  id_faq_question        Int      @db.UnsignedInt
  vc_phrase              String   @db.VarChar(255)
  dt_register            DateTime @default(now()) @db.Timestamp(0)
  question               faq_questions @relation(fields: [id_faq_question], references: [id_faq_question], onDelete: Cascade)

  @@index([id_faq_question], map: "idx_faq_question_phrases_question")
}

model faq_highlight_steps {
  id_faq_highlight_step Int      @id @default(autoincrement()) @db.UnsignedInt
  id_faq_question       Int      @db.UnsignedInt
  id_faq_screen_element Int      @db.UnsignedInt
  i_order               Int      @default(0)
  question              faq_questions @relation(fields: [id_faq_question], references: [id_faq_question], onDelete: Cascade)
  element               faq_screen_elements @relation(fields: [id_faq_screen_element], references: [id_faq_screen_element])

  @@index([id_faq_question, i_order], map: "idx_faq_highlight_steps_question")
}

model faq_cliente_questions {
  id_faq_cliente_question Int      @id @default(autoincrement()) @db.UnsignedInt
  vc_answer_text          String   @db.Text
  i_status                Int      @default(1) @db.TinyInt
  dt_register             DateTime @default(now()) @db.Timestamp(0)
  dt_updated              DateTime @default(now()) @updatedAt @db.Timestamp(0)
  vc_route                String?  @db.VarChar(100)
  phrases                 faq_cliente_phrases[]
}

model faq_cliente_phrases {
  id_faq_cliente_phrase   Int      @id @default(autoincrement()) @db.UnsignedInt
  id_faq_cliente_question Int      @db.UnsignedInt
  vc_phrase               String   @db.VarChar(255)
  dt_register             DateTime @default(now()) @db.Timestamp(0)
  question                faq_cliente_questions @relation(fields: [id_faq_cliente_question], references: [id_faq_cliente_question], onDelete: Cascade)

  @@index([id_faq_cliente_question], map: "idx_faq_cliente_phrases_question")
}
